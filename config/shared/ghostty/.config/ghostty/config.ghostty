theme = Catppuccin Mocha

font-family = JetBrains Mono
font-style = SemiBold
font-size = 14

# Prepare interactive SSH sessions with matching remote terminal capabilities.
shell-integration-features = ssh-env,ssh-terminfo

# Includes are loaded in order: platform settings, then personal overrides.
config-file = ?platform.conf
config-file = ?local.conf
