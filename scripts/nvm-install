#!/bin/bash

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    if [ -e "$NVM_DIR" ]; then
        echo -e "${RED}❌ $NVM_DIR exists but does not contain a valid NVM installation${NC}"
        exit 1
    fi

    echo -e "${BLUE}Installing NVM into $NVM_DIR...${NC}"
    git clone https://github.com/nvm-sh/nvm.git "$NVM_DIR"

    # Use the newest tagged release rather than the development branch.
    latest_nvm_version="$(git -C "$NVM_DIR" for-each-ref \
        --sort=-version:refname \
        --format='%(refname:short)' \
        --count=1 refs/tags)"
    git -C "$NVM_DIR" checkout --quiet "$latest_nvm_version"
    echo -e "${GREEN}✓ NVM $latest_nvm_version installed${NC}"
else
    echo -e "${GREEN}✓ NVM is already installed${NC}"
fi

# nvm is a shell function, so load it explicitly for this non-interactive script.
source "$NVM_DIR/nvm.sh"

echo -e "${BLUE}Installing the latest Node.js LTS release...${NC}"
nvm install --lts
nvm alias default 'lts/*'
nvm use default

echo -e "${GREEN}✓ Node.js $(node --version) installed and set as the default${NC}"
