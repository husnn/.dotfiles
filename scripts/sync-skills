#!/usr/bin/env bash
# Reconcile repository-managed skills without adopting unrelated local skills.

set -euo pipefail

usage() {
    printf '%s\n' 'Usage: sync-skills [--dry-run|--check]'
}

die() {
    printf 'sync-skills: %s\n' "$*" >&2
    exit 1
}

absolute_path() {
    local path=$1 part result='' old_ifs=$IFS
    local -a parts=()
    IFS=/ read -r -a parts <<< "$path"
    IFS=$old_ifs
    for part in "${parts[@]}"; do
        case "$part" in
            ''|.) ;;
            ..) result=${result%/*} ;;
            *) result="$result/$part" ;;
        esac
    done
    printf '%s\n' "${result:-/}"
}

link_points_to() {
    local target=$1 source=$2 value
    [ -L "$target" ] || return 1
    value=$(readlink "$target") || return 1
    case "$value" in
        /*) ;;
        *) value="${target%/*}/$value" ;;
    esac
    [ "$(absolute_path "$value")" = "$(absolute_path "$source")" ]
}

mode=sync
case "${1:-}" in
    '') ;;
    --dry-run) mode=dry-run ;;
    --check) mode=check ;;
    -h|--help)
        usage
        exit 0
        ;;
    *) die "unknown argument: $1" ;;
esac
[ "$#" -le 1 ] || die 'too many arguments'

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
repo_pointer="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/repo"
repo_skills="$repo/agents/skills"
managed_skills="$repo_pointer/agents/skills"
installed_skills="$HOME/.agents/skills"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"

[ -d "$repo_skills" ] || die "repository skill directory not found: $repo_skills"
link_points_to "$repo_pointer" "$repo" || die "managed checkout pointer is missing or incorrect: $repo_pointer"

case "$repo$repo_pointer$installed_skills$state_dir" in
    *$'\t'*|*$'\n'*|*$'\r'*) die 'paths cannot contain tabs or newlines' ;;
esac

declare -a add_targets=()
declare -a add_sources=()
declare -a remove_targets=()
declare -a remove_sources=()
declare -a conflicts=()
create_directory=0

if [ -L "$installed_skills" ]; then
    die "refusing to synchronize through a directory symlink: $installed_skills"
elif [ -e "$installed_skills" ]; then
    [ -d "$installed_skills" ] || die "skill path is not a directory: $installed_skills"
else
    create_directory=1
fi

for source in "$repo_skills"/*; do
    [ -d "$source" ] || continue
    [ ! -L "$source" ] || die "repository skills must be real directories: $source"
    [ -f "$source/SKILL.md" ] || continue

    name=${source##*/}
    case "$name" in
        ''|[!a-zA-Z0-9]*|*[!a-zA-Z0-9._-]*) die "invalid skill directory name: $name" ;;
    esac

    target="$installed_skills/$name"
    expected_source="$managed_skills/$name"
    if link_points_to "$target" "$expected_source"; then
        continue
    elif [ -e "$target" ] || [ -L "$target" ]; then
        conflicts+=("destination already exists and is not the managed link: $target")
    else
        add_targets+=("$target")
        add_sources+=("$expected_source")
    fi
done

if [ -d "$installed_skills" ]; then
    for target in "$installed_skills"/*; do
        [ -L "$target" ] || continue
        name=${target##*/}
        expected_source="$managed_skills/$name"

        # The source path identifies links created here. A local skill or a
        # symlink to any other source does not belong to this command.
        link_points_to "$target" "$expected_source" || continue
        if [ ! -d "$repo_skills/$name" ] || [ ! -f "$repo_skills/$name/SKILL.md" ]; then
            remove_targets+=("$target")
            remove_sources+=("$expected_source")
        fi
    done
fi

for ((index=0; index<${#conflicts[@]}; index++)); do
    printf 'Conflict: %s\n' "${conflicts[index]}" >&2
done
[ "${#conflicts[@]}" -eq 0 ] || exit 1

print_plan() {
    local index
    if [ "$create_directory" -eq 1 ]; then
        printf 'Create skill directory: %s\n' "$installed_skills"
    fi
    for ((index=0; index<${#remove_targets[@]}; index++)); do
        printf 'Unlink obsolete managed skill: %s\n' "${remove_targets[index]}"
    done
    for ((index=0; index<${#add_targets[@]}; index++)); do
        printf 'Link skill: %s -> %s\n' "${add_targets[index]}" "${add_sources[index]}"
    done
}

change_count=$((${#add_targets[@]} + ${#remove_targets[@]} + create_directory))
if [ "$mode" = check ]; then
    if [ "$change_count" -eq 0 ]; then
        printf 'Skill links: OK\n'
        exit 0
    fi
    print_plan
    exit 1
fi
if [ "$mode" = dry-run ]; then
    if [ "$change_count" -eq 0 ]; then printf 'Skill links: no changes\n'; else print_plan; fi
    exit 0
fi

mkdir -p "$state_dir"
lock_directory="$state_dir/sync-skills.lock"
mkdir "$lock_directory" 2>/dev/null || die "another skill sync may be running: $lock_directory"
trap 'rmdir "$lock_directory" 2>/dev/null || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$create_directory" -eq 1 ]; then
    if [ -e "$installed_skills" ] || [ -L "$installed_skills" ]; then
        die "skill directory appeared during synchronization: $installed_skills"
    fi
    mkdir -p "$installed_skills"
    printf 'Created skill directory: %s\n' "$installed_skills"
fi

for ((index=0; index<${#remove_targets[@]}; index++)); do
    target=${remove_targets[index]}
    expected_source=${remove_sources[index]}
    link_points_to "$target" "$expected_source" || die "managed link changed during synchronization: $target"
    unlink "$target"
    printf 'Unlinked obsolete managed skill: %s\n' "$target"
done

for ((index=0; index<${#add_targets[@]}; index++)); do
    target=${add_targets[index]}
    expected_source=${add_sources[index]}
    if [ -e "$target" ] || [ -L "$target" ]; then
        die "skill destination appeared during synchronization: $target"
    fi
    ln -s "$expected_source" "$target"
    printf 'Linked skill: %s -> %s\n' "$target" "$expected_source"
done

for ((index=0; index<${#add_targets[@]}; index++)); do
    link_points_to "${add_targets[index]}" "${add_sources[index]}" || \
        die "skill link verification failed: ${add_targets[index]}"
done

if [ "$change_count" -eq 0 ]; then printf 'Skill links: no changes\n'; fi
